<p style="color: green"><%= notice %></p>

<h1>User Books</h1>

<div id="user_books">
  <% @user_books.each do |user_book| %>
    <p>
      <strong>Username:</strong>
      <%= user_book.user.username %>

      <strong>Book Title:</strong>
      <%= user_book.book.title %>

      <%= link_to "Show", user_book_path(user_book) %>
      <%= link_to "Edit", edit_user_book_path(user_book) %>
      <%= link_to "Destroy", user_book_path(user_book),
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </p>
  <% end %>
</div>

<%= link_to "New User Book", new_user_book_path %>
<br>
<%= link_to "Book index", books_path %>
<br>
<%= link_to "User index", users_path %>